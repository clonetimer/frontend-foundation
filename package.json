{
  "name": "frontend-foundation",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @foundation/showcase dev",
    "dev:starter": "pnpm build:packages && pnpm --filter @foundation/starter dev",
    "build": "pnpm -r --filter=!@foundation/storybook --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "check": "pnpm verify:offline && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "consumer:test": "pnpm --filter @foundation/consumer-test test:consumer",
    "pack:foundation": "node tooling/scripts/pack-foundation.mjs",
    "storybook": "pnpm build:packages && pnpm --filter @foundation/storybook dev",
    "storybook:build": "pnpm build:packages && pnpm --filter @foundation/storybook build",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "lint:architecture": "node tooling/scripts/architecture-check.mjs",
    "lint:repository": "node tooling/scripts/repository-check.mjs",
    "verify:offline": "node tooling/scripts/offline-verify.mjs",
    "create:app": "node tooling/create-app/index.mjs",
    "profiles:list": "node tooling/create-app/index.mjs --list-profiles",
    "release:preflight": "node tooling/release/preflight.mjs",
    "release:plan": "node tooling/release/plan.mjs",
    "release:version": "node tooling/release/version.mjs",
    "project:doctor": "node tooling/create-app/doctor.mjs",
    "release:pack": "pnpm check:release && pnpm pack:foundation",
    "release:publish": "node tooling/release/publish.mjs",
    "check:release": "pnpm check && pnpm release:api && pnpm designer:build && pnpm storybook:build && pnpm consumer:test && pnpm domain:verify && pnpm release:preflight",
    "release:api": "node tooling/release/public-api.mjs",
    "pilot:management": "pnpm --filter @foundation/pilot-management build",
    "pilot:data": "pnpm --filter @foundation/pilot-data build",
    "project:upgrade": "node tooling/create-app/upgrade.mjs",
    "oss:baseline": "node tooling/oss/baseline.mjs",
    "oss:verify": "node tooling/oss/verify.mjs",
    "capability:verify": "node tooling/scripts/capability-check.mjs",
    "oss:scorecard": "node tooling/oss/scorecard.mjs",
    "deployments:list": "node tooling/create-app/index.mjs --list-deployments",
    "deploy:verify": "node tooling/deployment/verify.mjs",
    "patterns:list": "node tooling/create-app/generate.mjs --list-patterns",
    "contracts:list": "node tooling/create-app/index.mjs --list-contracts",
    "contract:adapters": "node tooling/create-app/contract.mjs --list-adapters",
    "contract:audit": "node tooling/create-app/contract.mjs audit",
    "deploy:smoke": "node tooling/deployment/http-smoke.mjs",
    "release:promote": "node tooling/release/promote.mjs",
    "github:verify": "node tooling/scripts/github-ci-check.mjs",
    "oss:kernel-baseline": "node tooling/oss/kernel-baseline.mjs",
    "project:compile": "node tooling/create-app/project.mjs compile",
    "project:status": "node tooling/create-app/project.mjs status",
    "designer": "pnpm build:packages && pnpm --filter @foundation/designer dev",
    "designer:build": "pnpm build:packages && pnpm --filter @foundation/designer build",
    "design-model:verify": "node tooling/scripts/design-model-sync.mjs",
    "designer:browser-smoke": "node tooling/scripts/designer-browser-smoke.mjs",
    "domain:verify": "pnpm domain:primary-verify && pnpm domain:secondary-verify",
    "domain:neutrality": "node tooling/scripts/domain-neutrality-check.mjs",
    "domain:primary-verify": "pnpm --filter @example/domain-widgets build && node tooling/create-app/domain-component.mjs verify packages/domain-widgets-fixture --pack",
    "domain:secondary-verify": "pnpm exec tsc -p tooling/fixtures/secondary-domain-widgets/tsconfig.build.json && node tooling/create-app/domain-component.mjs verify tooling/fixtures/secondary-domain-widgets --built --pack"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@eslint/js": "catalog:"
  }
}
