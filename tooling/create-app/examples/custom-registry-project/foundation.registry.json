{
  "schemaVersion": 1,
  "widgets": [
    {
      "id": "example.interactive-viewer",
      "package": "@example/domain-widgets",
      "version": "^2.0.0",
      "exportName": "InteractiveViewer",
      "description": "Project-owned overview visualization widget.",
      "properties": [
        {
          "key": "itemId",
          "label": "Item",
          "kind": "text",
          "required": true
        },
        {
          "key": "mode",
          "label": "Mode",
          "kind": "select",
          "options": [
            "overview",
            "detail"
          ],
          "default": "overview"
        }
      ],
      "bindings": {
        "itemId": "string"
      },
      "events": {
        "select": {
          "prop": "onSelect",
          "valueType": "string",
          "parameter": "value"
        }
      }
    }
  ],
  "blocks": [
    {
      "id": "example.analysis-section",
      "package": "@example/domain-widgets",
      "version": "^2.0.0",
      "exportName": "AnalysisSection",
      "description": "Project-owned composition container for generic analysis modules.",
      "acceptsChildren": true,
      "properties": [
        {
          "key": "title",
          "label": "Title",
          "kind": "text",
          "default": "Analysis"
        }
      ]
    }
  ]
}
