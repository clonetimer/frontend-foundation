{
  "schemaVersion": 1,
  "foundationVersion": "{{foundationVersion}}",
  "profile": {
    "name": "{{profile}}",
    "source": "{{profileSource}}",
    "capabilities": {{profileCapabilitiesJson}},
    "foundationPackages": {{profileFoundationPackagesJson}},
    "dependencies": {{profileDependenciesJson}}
  },
  "ui": {
    "shell": "{{shellPreset}}"
  },
  "deployment": "{{deployment}}",
  "contractMode": "{{contractMode}}",
  "contracts": {{contractsJson}},
  "modules": {
    "directory": "src/modules",
    "routeFile": "routes.ts",
    "exportName": "module"
  }
}
